{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/.dev/user-data",
        "${workspaceFolder}/.dev/test-workspace"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "调试准备"
    },
    {
      "name": "运行测试",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/out/test/host",
        "--user-data-dir=${workspaceFolder}/.dev/host-test-user-data",
        "--extensions-dir=${workspaceFolder}/.dev/host-test-extensions"
      ],
      "outFiles": ["${workspaceFolder}/out/test/**/*.js"],
      "preLaunchTask": "准备宿主测试"
    }
  ]
}
